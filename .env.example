# Tax Map configuration. Copy to .env and fill in. .env is gitignored; never commit real keys.
# Every variable the code reads is listed here; commented-out lines show the default.

# --- Server
# Port to listen on. When PORT is set here or in the environment the server listens on all interfaces
# (0.0.0.0, for a container); when it is unset it listens on 127.0.0.1:8080 only.
# PORT=8080

# --- Mode
# true: runs replay data/samples (no keys, no Zetaris, no Nightshift). false: live runs.
SAMPLE_MODE=false
# Milliseconds between replayed events in sample mode (capped at 5000).
# SAMPLE_DELAY_MS=200
# Folder of recorded samples.
# SAMPLES_DIR=data/samples

# --- Meterless Nightshift (primary AI provider)
# Nightshift's OpenAI-compatible endpoint.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Runtime token for Nightshift. Secret: never logged, cut out of every error message.
METERLESS_RUNTIME_TOKEN=
# App (lane) name for the Researcher's calls. The Critic's calls use the app "taxmap-critic".
METERLESS_APP=taxmap
# Researcher model (Lane 1).
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Critic model (Lane 2), also used for the plain-words check.
METERLESS_CRITIC_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# JSONL log of every model call (metadata and receipt ids only, no content).
# METERLESS_LOG_FILE=logs/model_calls.jsonl
# 1: log each request's size and outcome to stderr (sizes only, never content or the token).
# METERLESS_DEBUG=

# --- Zetaris (statute tables)
# Zetaris REST API.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Zetaris organisation id.
ZETARIS_ORG_ID=1
# Zetaris API key. Secret: never logged, cut out of every error message.
ZETARIS_API_KEY=
# Commit of this repo whose data/statutes JSON scripts/register_tables.ts registers. Needed for taxmap.levies.
# STATUTE_COMMIT=

# --- Critic
# Longest piece of section text per Critic call; longer sections are judged in pieces.
CRITIC_PIECE_CHARS=6000
# Off-by-default fallback: true sends a Critic call that failed on Nightshift straight to NVIDIA (no signed receipt).
CRITIC_DIRECT_NVIDIA=
# NVIDIA API key, used only by that fallback. Secret.
NVIDIA_API_KEY=

# --- Storage (defaults shown; all gitignored)
# Finished runs, one JSON file each.
# RUNS_DIR=logs/runs
# H-MEM memories and its trust ledger.
# HMEM_DIR=data/memory
# HMEM_LOG_DIR=logs/hmem
# World Model document and its event log.
# WM_DIR=data/world_model
# WM_LOG_DIR=logs/world_model

# --- scripts/parse_acts.py only (re-parsing the PDFs)
# Folder holding the source PDFs (gazette/, ctc/, other/ with their hashes.txt).
# TAXMAP_ACTS_DIR=
# Which Nigeria Tax Act copy to parse: fgp (cited) or lirs (for comparison).
# TAXMAP_NTA_COPY=fgp
# 1: split words glued across the body/margin boundary (default); 0 to compare without.
# TAXMAP_SPLIT_GLUED=1
